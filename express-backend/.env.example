NODE_ENV=development
PORT=4000

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=templates
DB_PASSWORD=templates
DB_NAME=templates_dev

# Separate signing keys per app. Storefront cookies and admin cookies
# never overlap, and even if one secret leaks the other console is safe.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET_STOREFRONT=
AUTH_SECRET_ADMIN=

# CORS allow-list (comma separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Default admin seeded on first boot
SEED_ADMIN_EMAIL=admin@productone.example
SEED_ADMIN_PASSWORD=admin1234

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=products

# Slack — new order alerts (bot token needs chat:write scope, invited to the channel)
SLACK_TOKEN=
SLACK_ALERT_CHANNEL='#ayroil-notifications'

# Web Push (VAPID) — admin PWA new-order notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Twilio WhatsApp — order-confirmation message on checkout.
# console.twilio.com → Account → API keys & tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886; production: your approved WhatsApp sender.
TWILIO_WHATSAPP_FROM=
# Optional: approved Content Template SID (see src/lib/whatsapp.ts for the {{1}}..{{7}} field mapping).
# Without it, a plain-text fallback is sent instead.
TWILIO_CONTENT_SID=
# Country used to fill in a missing country code on customer-entered phone numbers.
WHATSAPP_DEFAULT_COUNTRY=PK
