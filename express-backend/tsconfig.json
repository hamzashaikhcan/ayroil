{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS, not ESNext: with emitDecoratorMetadata on, TypeORM's circular
    // entity relations (Order <-> OrderItem) emit a bare `Reflect.metadata(...,
    // Order)` at module-eval time. Under native ESM that hits the live-binding
    // TDZ ("Cannot access 'Order' before initialization"); CJS's `require()`
    // tolerates it because the (still-filling-in) exports object is returned
    // by reference. Doesn't affect `dev`, which runs through tsx instead of tsc.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "paths": {
      "@consts": ["./src/consts.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
